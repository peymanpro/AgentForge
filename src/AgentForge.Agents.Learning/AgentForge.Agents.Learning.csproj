<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>AgentForge.Agents.Learning</AssemblyName>
    <RootNamespace>AgentForge.Agents.Learning</RootNamespace>
    <PackageId>AgentForge.Agents.Learning</PackageId>
    <Description>Feedback-driven epsilon-greedy and disjoint LinUCB contextual bandit learning agents.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/peymanpro/AgentForge</RepositoryUrl>
    <PackageTags>ai;agents;learning;multi-armed-bandit;contextual-bandit;linucb;epsilon-greedy</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AgentForge.Abstractions\AgentForge.Abstractions.csproj" />
    <ProjectReference Include="..\AgentForge.Agents.Learning.Application\AgentForge.Agents.Learning.Application.csproj">
      <TreatAsPackageReference>false</TreatAsPackageReference>
    </ProjectReference>
    <ProjectReference Include="..\AgentForge.Agents.Learning.Domain\AgentForge.Agents.Learning.Domain.csproj">
      <TreatAsPackageReference>false</TreatAsPackageReference>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>