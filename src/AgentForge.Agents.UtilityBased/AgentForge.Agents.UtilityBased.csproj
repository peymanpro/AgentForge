<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>AgentForge.Agents.UtilityBased</AssemblyName>
    <RootNamespace>AgentForge.Agents.UtilityBased</RootNamespace>
    <PackageId>AgentForge.Agents.UtilityBased</PackageId>
    <Description>A standalone Utility-Based agent module with a fluent API.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/peymanpro/AgentForge</RepositoryUrl>
    <PackageTags>ai;agents;utility-based;decision-making;fluent-api;agent-engineering</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AgentForge.Abstractions\AgentForge.Abstractions.csproj" />
    <ProjectReference Include="..\AgentForge.Agents.UtilityBased.Application\AgentForge.Agents.UtilityBased.Application.csproj">
      <TreatAsPackageReference>false</TreatAsPackageReference>
    </ProjectReference>
    <ProjectReference Include="..\AgentForge.Agents.UtilityBased.Domain\AgentForge.Agents.UtilityBased.Domain.csproj">
      <TreatAsPackageReference>false</TreatAsPackageReference>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="\\" />
  </ItemGroup>
</Project>